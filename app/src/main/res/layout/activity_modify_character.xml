<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ModifyCharacterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnSaveCharacter"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCharacterHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                tools:text="Drizzt Do'Urden (Level 15)" />

            <LinearLayout
                android:id="@+id/contentSectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBuild"
                    style="@style/Widget.MaterialComponents.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <RelativeLayout
                            android:id="@+id/headerBuild"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:id="@+id/titleBuild"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:text="Build"/>
                            <ImageView
                                android:id="@+id/indicatorBuild"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/black"/>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/contentBuild"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Race">
                                <AutoCompleteTextView
                                    android:id="@+id/autoCompleteRace"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:hint="Class">
                                <AutoCompleteTextView
                                    android:id="@+id/autoCompleteClass"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6. ABILITY SCORES"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="8dp"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Strength (STR)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_str"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" /> </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Dexterity (DEX)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_dex"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Constitution (CON)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_con"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Intelligence (INT)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_int"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Wisdom (WIS)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_wis"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Charisma (CHA)"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                                android:layout_marginBottom="16dp">
                                <AutoCompleteTextView
                                    android:id="@+id/auto_complete_cha"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMagic"
                    style="@style/Widget.MaterialComponents.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <RelativeLayout
                            android:id="@+id/headerMagic"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/titleMagic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:text="Magic"/>

                            <ImageView
                                android:id="@+id/indicatorMagic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/black"/>

                            <ImageView
                                android:id="@+id/disabledMagic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@id/indicatorMagic"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_lock"
                                app:tint="@android:color/darker_gray"
                                android:visibility="gone"/>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/contentMagic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="4dp"
                                android:layout_marginBottom="16dp">
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="4dp"
                                android:layout_marginBottom="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <RelativeLayout
                                        android:id="@+id/header_spells"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:padding="16dp"
                                        android:background="?attr/selectableItemBackground">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="4. SPELLS"
                                            android:textSize="18sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black" />

                                        <ImageView
                                            android:id="@+id/indicator_spells"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentEnd="true"
                                            android:src="@drawable/ic_arrow_down" />

                                        <ImageView
                                            android:id="@+id/disabled_indicator_spells"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginEnd="8dp"
                                            android:layout_toStartOf="@id/indicator_spells"
                                            android:src="@drawable/ic_lock"
                                            android:visibility="gone"
                                            app:tint="@color/gray" />
                                    </RelativeLayout>

                                    <LinearLayout
                                        android:id="@+id/content_spells"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="16dp"
                                        android:visibility="gone">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Select Spells (Auto-Complete)"
                                            android:textStyle="italic"
                                            android:layout_marginBottom="8dp"/>

                                        <com.google.android.material.textfield.TextInputLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:hint="Spell 1"
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                            <AutoCompleteTextView
                                                android:id="@+id/auto_complete_spell_1"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="none" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:hint="Spell 2"
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                            <AutoCompleteTextView
                                                android:id="@+id/auto_complete_spell_2"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="none" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                        <com.google.android.material.textfield.TextInputLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:hint="Spell 3"
                                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
                                            <AutoCompleteTextView
                                                android:id="@+id/auto_complete_spell_3"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:inputType="none" />
                                        </com.google.android.material.textfield.TextInputLayout>

                                    </LinearLayout>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEquipment"
                    style="@style/Widget.MaterialComponents.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RelativeLayout
                            android:id="@+id/headerEquipment"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:id="@+id/titleEquipment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:text="Equipment"/>
                            <ImageView
                                android:id="@+id/indicatorEquipment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/black"/>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/contentEquipment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add New Item, Weapon, or Armor:"
                                android:textStyle="italic"
                                android:layout_marginBottom="8dp"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Search for Equipment"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">

                                <AutoCompleteTextView
                                    android:id="@+id/autoCompleteEquipment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Inventory:"
                                android:textStyle="bold"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:id="@+id/inventoryItemsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManage"
                    style="@style/Widget.MaterialComponents.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <RelativeLayout
                            android:id="@+id/headerManage"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                android:id="@+id/titleManage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:text="Manage"/>
                            <ImageView
                                android:id="@+id/indicatorManage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_arrow_down"
                                app:tint="@color/black"/>
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/contentManage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Character Name">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etCharacterName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapWords"
                                    android:maxLines="1"
                                    tools:text="Drizzt Do'Urden"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Level">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etCharacterLevel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:maxLength="2"
                                    tools:text="15"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Racial and Class Features / Traits"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp"/>

                            <LinearLayout
                                android:id="@+id/featuresTraitsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="[Placeholder: Esta área se poblará dinámicamente en Java con los rasgos de Raza y Clase.]"
                                    android:textStyle="italic"
                                    android:textColor="@color/gray"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSheet"
                style="@style/Widget.MaterialComponents.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <RelativeLayout
                        android:id="@+id/headerSheet"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/titleSheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:text="Character Sheet"/>

                        <ImageView
                            android:id="@+id/indicatorSheet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/black"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/contentSheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp"
                            android:baselineAligned="false">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Race:" android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvSheetRace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="[Race Name]"
                                    android:textSize="16sp"
                                    android:layout_marginBottom="8dp"/>

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Class:" android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvSheetClass"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="[Class Name / Level]"
                                    android:textSize="16sp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                tools:ignore="RtlSymmetry">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Armor Class (AC):" android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvSheetAC"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="[Calculated AC]"
                                    android:textSize="16sp"
                                    android:layout_marginBottom="8dp"/>

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hit Points (HP):" android:textStyle="bold"/>
                                <TextView
                                    android:id="@+id/tvSheetHP"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="[Max HP]"
                                    android:textSize="16sp"/>

                            </LinearLayout>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray" android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ABILITY SCORES"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Strength (STR):" android:layout_marginEnd="8dp"/>
                            <TextView
                                android:id="@+id/tvSheetSTR"
